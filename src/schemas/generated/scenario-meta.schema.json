{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SCN-\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "active",
        "running",
        "passed",
        "regression",
        "failed",
        "item-created",
        "awaiting-fix",
        "ready-for-verification",
        "verified",
        "blocked",
        "invalid",
        "needs-product-review",
        "deprecated",
        "graduated"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "persona": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "human-seeded",
        "agent-discovered"
      ]
    },
    "lastResult": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "unknown",
        "queued",
        "running",
        "passed",
        "failed",
        "blocked",
        "flaky",
        "invalid",
        "inconclusive",
        "archived"
      ]
    },
    "lastRunId": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "linkedIssues": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "setup": {
          "type": "string"
        },
        "teardown": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "priority",
    "persona",
    "source"
  ]
}
