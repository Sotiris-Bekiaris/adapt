{
  "type": "object",
  "properties": {
    "targetRepoPath": {
      "type": "string",
      "minLength": 1
    },
    "appBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "playwrightTestDir": {
      "type": "string",
      "default": "tests/adapt"
    },
    "startCommand": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "claude-code",
            "stub"
          ],
          "default": "claude-code"
        },
        "command": {
          "type": "string"
        },
        "skipPermissions": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "console": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 4399
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "hooks": {
      "type": "object",
      "properties": {
        "setup": {
          "type": "string"
        },
        "teardown": {
          "type": "string"
        },
        "requireSetupHook": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "jira": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "default": "http://localhost:8080"
        },
        "projectKey": {
          "type": "string",
          "default": ""
        },
        "defaultIssueType": {
          "type": "string",
          "default": "Bug"
        },
        "transitions": {
          "type": "object",
          "properties": {
            "inReview": {
              "type": "string",
              "default": "In Review"
            },
            "readyForVerification": {
              "type": "string",
              "default": "Ready for Verification"
            },
            "done": {
              "type": "string",
              "default": "Done"
            },
            "reopened": {
              "type": "string",
              "default": "In Progress"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "mcp": {
      "type": "object",
      "properties": {
        "playwright": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "chromeDevTools": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "jira": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxFixAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 2
        },
        "maxVerificationAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3
        },
        "maxItemsPerRun": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 10
        },
        "maxCycleSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3600
        },
        "maxDemandsPerCycle": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3
        },
        "maxScenariosPerDemand": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 2
        },
        "gradPassThreshold": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "run": {
      "type": "object",
      "properties": {
        "maxCycles": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "maxWallClockSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pauseSeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "maxConsecutiveErrors": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "environment": {
      "type": "object",
      "properties": {
        "up": {
          "type": "string"
        },
        "down": {
          "type": "string"
        },
        "reset": {
          "type": "string"
        },
        "portBase": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 54300
        },
        "portStride": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 100
        }
      },
      "additionalProperties": false
    },
    "lanes": {
      "type": "object",
      "properties": {
        "rootDir": {
          "type": "string",
          "default": "../adapt-lanes"
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [
    "targetRepoPath",
    "appBaseUrl"
  ],
  "additionalProperties": false
}
