{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "targetRepoPath": {
      "type": "string",
      "minLength": 1
    },
    "appBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "playwrightTestDir": {
      "default": "tests/adapt",
      "type": "string"
    },
    "startCommand": {
      "type": "string"
    },
    "engine": {
      "default": {},
      "type": "object",
      "properties": {
        "type": {
          "default": "claude-code",
          "type": "string",
          "enum": [
            "claude-code",
            "stub"
          ]
        },
        "command": {
          "type": "string"
        },
        "skipPermissions": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "console": {
      "default": {},
      "type": "object",
      "properties": {
        "port": {
          "default": 4399,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "hooks": {
      "default": {},
      "type": "object",
      "properties": {
        "setup": {
          "type": "string"
        },
        "teardown": {
          "type": "string"
        },
        "requireSetupHook": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "jira": {
      "default": {},
      "type": "object",
      "properties": {
        "projectKey": {
          "default": "",
          "type": "string"
        }
      }
    },
    "mcp": {
      "default": {},
      "type": "object",
      "properties": {
        "playwright": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            }
          }
        },
        "chromeDevTools": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            }
          }
        },
        "jira": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            }
          }
        }
      }
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "maxFixAttempts": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxVerificationAttempts": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxItemsPerRun": {
          "default": 10,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCycleSeconds": {
          "default": 3600,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxDemandsPerCycle": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxScenariosPerDemand": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "gradPassThreshold": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "run": {
      "default": {},
      "type": "object",
      "properties": {
        "maxCycles": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "maxWallClockSeconds": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "pauseSeconds": {
          "default": 5,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxConsecutiveErrors": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "up": {
          "type": "string"
        },
        "down": {
          "type": "string"
        },
        "reset": {
          "type": "string"
        },
        "portBase": {
          "default": 54300,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "portStride": {
          "default": 100,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "lanes": {
      "default": {},
      "type": "object",
      "properties": {
        "rootDir": {
          "default": "../adapt-lanes",
          "type": "string"
        }
      }
    }
  },
  "required": [
    "targetRepoPath",
    "appBaseUrl"
  ]
}
