# Matches the style already used throughout the repo: 2-space indent, LF, UTF-8.
# See CONTRIBUTING.md for the rest of the conventions (double quotes, semicolons).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Two trailing spaces are a hard line break in Markdown — do not strip them.
trim_trailing_whitespace = false
max_line_length = off

[*.{sh,mjs}]
# scripts/ is bash and ESM; same 2-space, LF style.
indent_size = 2

[*.{html,css}]
# The shipped pages keep long single-line style rules and inline SVG paths as-is.
max_line_length = off
