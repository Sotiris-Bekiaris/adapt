# adapt — Jira credentials for the mcp-atlassian MCP server.
#
#   cp scripts/jira.env.example scripts/jira.env   # then fill in your own values
#
# The real file (scripts/jira.env) is gitignored — never commit it, and never paste a token into
# this .example file.
#
# WHO READS THIS FILE
#   scripts/run-autonomous.sh sources it with `set -a`. adapt then harvests the keys that are
#   actually set and embeds them in the jira `--mcp-config` payload it hands to Claude Code
#   (src/engine/claudeCode.ts → jiraMcpEnv / resolveMcpConfig). The server itself is launched as
#   `uvx mcp-atlassian`, so `uvx` (from Astral uv) must be on PATH:
#       curl -LsSf https://astral.sh/uv/install.sh | sh
#
# ENTIRELY OPTIONAL
#   To run adapt with no work tracker at all, set `"mcp": { "jira": { "enabled": false } }` in the
#   target's .adapt/config.json and skip this file. run-autonomous.sh treats it as optional.
#
# PER-TARGET OVERRIDE
#   <targetRepo>/.adapt/jira.env wins over this shared file when present.

# --- pick ONE auth mode ------------------------------------------------------
# PAT (self-hosted Server / Data Center) and username+token (Cloud) are mutually exclusive.
# When a personal access token is set, adapt deliberately does NOT forward JIRA_USERNAME /
# JIRA_API_TOKEN, so a stray Cloud token exported in your shell for another tool cannot hijack a
# self-hosted run (src/engine/claudeCode.ts, jiraMcpEnv).

# Mode A — Jira Server / Data Center, personal access token.
# Create one in Jira: avatar (top right) → Profile → Personal Access Tokens → Create token.
JIRA_URL=https://your-jira.example.com
JIRA_PERSONAL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mode B — Jira Cloud, email + API token. Comment out Mode A above if you use this.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_URL=https://your-site.atlassian.net
# JIRA_USERNAME=you@example.com
# JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- optional ----------------------------------------------------------------
# Every key below is forwarded only when it is set to a non-empty value.

# Set false only for an https endpoint with a self-signed certificate. Ignored over plain http.
# JIRA_SSL_VERIFY=false

# Restrict the MCP tools to one project key, so agents cannot touch anything else.
# JIRA_PROJECTS_FILTER=PROJ

# Let agents read Jira but never write to it. Useful for a first supervised run.
# READ_ONLY_MODE=true

# Allowlist the mcp-atlassian tools the agents may call, instead of exposing all of them.
# ENABLED_TOOLS=jira_search,jira_get_issue,jira_create_issue,jira_transition_issue

# Confluence, if you want the same server to expose it. Pair the PAT with Mode A, the
# username/token pair with Mode B.
# CONFLUENCE_URL=https://your-jira.example.com/wiki
# CONFLUENCE_PERSONAL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONFLUENCE_USERNAME=you@example.com
# CONFLUENCE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
