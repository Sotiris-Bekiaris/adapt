# adapt — provider environment for agent runs.
#
#   cp scripts/deepseek.env.example scripts/deepseek.env   # then fill in your own values
#
# The real file (scripts/deepseek.env) is gitignored — never commit it, and never paste a
# token into this .example file.
#
# WHO READS THIS FILE
#   scripts/run-autonomous.sh sources it with `set -a`, so every key below is exported into the
#   `adapt` process and inherited by every spawned `claude` (src/engine/claudeCode.ts spawns the
#   agent with `env: { ...process.env, ...spec.env }`). Nothing else in adapt reads these keys —
#   they are Claude Code's own configuration variables. Your interactive `claude` sessions are
#   unaffected; the exports live only inside the launcher's process tree.
#
# WHEN YOU DO NOT NEED THIS FILE
#   If you run Claude Code against Anthropic with its normal login, you do not need this file at
#   all. run-autonomous.sh will say so and continue. It exists for the "route Claude Code at an
#   Anthropic-compatible third-party endpoint" path, which is what scripts/ds-proxy.mjs supports.
#
# PER-TARGET OVERRIDE
#   <targetRepo>/.adapt/deepseek.env wins over this shared file when present.

# --- endpoint ----------------------------------------------------------------
# Point Claude Code at the local normalizing proxy, not directly at the provider:
# scripts/ds-proxy.mjs rewrites thinking:{type:"disabled"} -> {type:"adaptive"} so subagent
# dispatches do not 400 on a reasoning model. run-autonomous.sh starts the proxy for you; to run
# it by hand: `node scripts/ds-proxy.mjs 8788`.
#
# The proxy forwards the request path unchanged to its upstream host (api.deepseek.com by
# default), so include whatever path prefix your provider's Anthropic-compatible API lives under.
ANTHROPIC_BASE_URL=http://127.0.0.1:8788/anthropic

# Your provider API key. Claude Code sends this as the bearer token.
# run-autonomous.sh unsets ANTHROPIC_API_KEY after sourcing this file, so an ambient Anthropic
# key in your shell cannot override the token below.
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- model routing -----------------------------------------------------------
# Claude Code asks for a model by tier (opus / sonnet / haiku). These map each tier onto a real
# model id at your provider. Set them all to the same id unless you deliberately want cheaper
# subagents. Replace the placeholder with an id your provider documents.
ANTHROPIC_MODEL=your-model-id
ANTHROPIC_DEFAULT_OPUS_MODEL=your-model-id
ANTHROPIC_DEFAULT_SONNET_MODEL=your-model-id
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-model-id

# Model used specifically for subagent dispatches.
CLAUDE_CODE_SUBAGENT_MODEL=your-model-id

# --- reasoning ---------------------------------------------------------------
# Leave thinking enabled. The HTTP 400 that ds-proxy.mjs works around only fires when thinking is
# *disabled* while a reasoning effort is set — see the header of scripts/ds-proxy.mjs.
CLAUDE_CODE_EFFORT_LEVEL=high
MAX_THINKING_TOKENS=32000

# --- timeouts ----------------------------------------------------------------
# adapt runs long agent turns and long shell commands (installs, DB resets, dev-server boots).
# The stock defaults are too short for an unattended loop. Values are milliseconds.
API_TIMEOUT_MS=3600000
BASH_DEFAULT_TIMEOUT_MS=600000
BASH_MAX_TIMEOUT_MS=1800000
