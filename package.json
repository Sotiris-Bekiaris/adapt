{
  "name": "adapt",
  "version": "0.1.0",
  "description": "Scenario-Driven Agentic Development — a closed-loop multi-agent system that autonomously evolves a software product.",
  "license": "MIT",
  "author": "Sotiris Bekiaris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sotiris-Bekiaris/adapt.git"
  },
  "homepage": "https://github.com/Sotiris-Bekiaris/adapt#readme",
  "bugs": {
    "url": "https://github.com/Sotiris-Bekiaris/adapt/issues"
  },
  "keywords": [
    "agents",
    "agentic",
    "autonomous-agents",
    "multi-agent",
    "scenario-driven-development",
    "sdad",
    "claude-code",
    "mcp",
    "playwright",
    "cli",
    "typescript"
  ],
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "adapt": "bin/adapt.mjs"
  },
  "scripts": {
    "adapt": "tsx src/cli/index.ts",
    "check": "npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas": "tsx src/schemas/export.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "ws": "^8.21.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
